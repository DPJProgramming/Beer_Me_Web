# will be generated when node is installed locally
node_modules

# database files for sqlite
data/*
!data/.gitkeep

# Ignore all images in the public/img directory to save space
public/img
!public/img/placeholder.png #keep the placeholder.png file

# environment variables
*.env
.env.*
.env
!.env.example

# Logs
logs/
*.log
npm-debug.log*

#aws
oac.json
policy.json

# Terraform: keep configuration tracked, ignore generated/local/sensitive artifacts
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.tfvars.json
terraform/*.backup
terraform/crash.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
function.zip
# Keep the example file for reference
!terraform/*.tfvars.example

#misc
/resources

